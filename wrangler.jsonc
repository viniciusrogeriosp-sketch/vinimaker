{
  "name": "vinimaker-fotos",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/f/*"] },
  "durable_objects": { "bindings": [{ "name": "LOJA", "class_name": "Loja" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Loja"] }],
  "vars": { "DROPBOX_PASTA": "/Hípica - Beach Tênnis 7 e 8", "MAX_APARELHOS": "2" },
  "observability": { "enabled": true }
}
